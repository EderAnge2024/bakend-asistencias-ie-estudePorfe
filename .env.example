# Puerto del servidor backend
PORT=5000

# Base de Datos local de Asistencias (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=bd_asistenciasIE
DB_PASSWORD=tu_password_postgres
DB_PORT=5432

# URL de la Base de Datos del Sistema de Monitoreo (Aiven / PostgreSQL Cloud)
# Reemplaza con tu propia URL de conexión
DATABASE_URL=postgres://usuario:password@host:puerto/defaultdb?sslmode=require

# (Opcional) URL para la BD de Asistencias si se despliega en la nube (Render / Supabase / Neon)
# Al configurar en Render, agrega esta variable con tu URL de PostgreSQL
# DATABASE_URL_ASISTENCIAS=postgres://usuario:password@host:puerto/defaultdb?sslmode=require

# Secreto para firma de tokens JWT — cámbialo por uno seguro en producción
JWT_SECRET=asistencias_ie_secret_key_2026_super_segura
